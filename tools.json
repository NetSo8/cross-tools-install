      "description": "Procmon, Process Explorer et outils système Microsoft",
      "packages": {"windows": [{"manager": "scoop", "name": "sysinternals"}, {"manager": "winget", "name": "Microsoft.Sysinternals"}, {"manager": "winget", "name": "9P7KNL5RWT25", "source": "msstore"}]}
    },
    {
      "name": "System Informer",
      "category": "Windows",
