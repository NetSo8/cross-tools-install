    {
      "name": "ltrace",
      "category": "Linux",
      "description": "Traçage des bibliothèques dynamiques",
      "packages": {"linux": [{"manager": "apt", "name": "ltrace"}, {"manager": "dnf", "name": "ltrace"}, {"manager": "pacman", "name": "ltrace"}]}
    },
    {
      "name": "Valgrind",
      "category": "Linux",
      "description": "Détection des fuites et accès mémoire invalides",
      "packages": {"linux": [{"manager": "apt", "name": "valgrind"}, {"manager": "dnf", "name": "valgrind"}, {"manager": "pacman", "name": "valgrind"}]}
    },
    {
      "name": "perf",
