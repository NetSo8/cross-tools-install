      "packages": {
        "windows": [{"manager": "winget", "name": "MSYS2.MSYS2"}, {"manager": "scoop", "name": "gcc"}],
        "linux": [{"manager": "apt", "name": "gcc"}, {"manager": "dnf", "name": "gcc"}, {"manager": "pacman", "name": "gcc"}],
        "darwin": [{"manager": "brew", "name": "gcc"}]
