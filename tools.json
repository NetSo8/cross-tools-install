{
  "version": 1,
  "tools": [
    {
      "name": "Ghidra",
      "category": "Reverse engineering",
      "description": "Décompilateur et framework d'analyse binaire",
      "packages": {
        "windows": [{"manager": "scoop", "name": "ghidra"}, {"manager": "winget", "name": "NSA.Ghidra"}],
        "linux": [{"manager": "apt", "name": "ghidra"}, {"manager": "dnf", "name": "ghidra"}, {"manager": "pacman", "name": "ghidra"}],
        "darwin": [
          {"manager": "script", "name": "ghidra", "command": "bash", "args": ["-c", "set -e; brew install --cask temurin; root=$HOME/.local/opt; mkdir -p $root; url=$(curl -fsSL https://api.github.com/repos/NationalSecurityAgency/ghidra/releases/latest | grep -oE 'https://[^ ]+PUBLIC[^ ]+\\.zip' | head -n 1); archive=$root/ghidra.zip; curl -fL $url -o $archive; unzip -q -o $archive -d $root; rm -f $archive"]},
          {"manager": "brew", "name": "ghidra", "options": ["--cask"]}
        ]
      }
    },
    {
      "name": "Cutter / Rizin",
      "category": "Reverse engineering",
      "description": "Interface graphique moderne pour l'analyse de binaires",
      "packages": {
        "windows": [{"manager": "scoop", "name": "cutter"}, {"manager": "winget", "name": "rizinorg.Cutter"}],
        "linux": [{"manager": "apt", "name": "cutter"}, {"manager": "dnf", "name": "cutter"}, {"manager": "pacman", "name": "cutter"}],
        "darwin": [{"manager": "brew", "name": "cutter", "options": ["--cask"]}]
      }
    },
    {
      "name": "ImHex",
      "category": "Reverse engineering",
      "description": "Éditeur hexadécimal avec patterns PE, ELF et Mach-O",
      "packages": {
        "windows": [{"manager": "scoop", "name": "imhex"}, {"manager": "winget", "name": "WerWolv.ImHex"}],
        "linux": [{"manager": "apt", "name": "imhex"}, {"manager": "pacman", "name": "imhex"}],
        "darwin": [{"manager": "brew", "name": "imhex", "options": ["--cask"]}]
      }
    },
    {
      "name": "Wireshark",
      "category": "Reverse engineering",
      "description": "Analyseur de trafic réseau",
      "packages": {
        "windows": [{"manager": "scoop", "name": "wireshark"}, {"manager": "winget", "name": "WiresharkFoundation.Wireshark"}],
        "linux": [{"manager": "apt", "name": "wireshark"}, {"manager": "dnf", "name": "wireshark"}, {"manager": "pacman", "name": "wireshark-qt"}],
        "darwin": [{"manager": "brew", "name": "wireshark", "options": ["--cask"]}]
      }
    },
    {
      "name": "Frida",
      "category": "Reverse engineering",
      "description": "Instrumentation dynamique de processus",
      "packages": {
        "all": [{"manager": "pip", "name": "frida-tools"}]
      }
    },
    {
      "name": "LLVM / Clang",
      "category": "C / toolchain",
      "description": "Compilateur C/C++ et outils d'analyse modernes",
      "packages": {
        "windows": [{"manager": "scoop", "name": "llvm"}, {"manager": "winget", "name": "LLVM.LLVM"}],
        "linux": [{"manager": "apt", "name": "clang"}, {"manager": "dnf", "name": "clang"}, {"manager": "pacman", "name": "clang"}],
        "darwin": [{"manager": "brew", "name": "llvm"}]
      }
    },
    {
      "name": "GCC",
      "category": "C / toolchain",
      "description": "Compilateur C/C++ de référence sous Linux",
