    },
    {
      "name": "CMake",
      "category": "C / toolchain",
      "description": "Générateur de projets C/C++",
      "packages": {"all": [{"manager": "brew", "name": "cmake"}, {"manager": "scoop", "name": "cmake"}, {"manager": "apt", "name": "cmake"}]}
