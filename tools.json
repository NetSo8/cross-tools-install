      "packages": {"linux": [{"manager": "apt", "name": "linux-tools-generic"}, {"manager": "dnf", "name": "perf"}, {"manager": "pacman", "name": "perf"}]}
    },
    {
      "name": "FlameGraph",
      "category": "Linux",
      "description": "Visualisation des profils de performance",
      "packages": {"linux": [{"manager": "script", "name": "FlameGraph", "command": "bash", "args": ["-c", "set -e; root=$HOME/.local/share/FlameGraph; if [ ! -d $root ]; then git clone --depth 1 https://github.com/brendangregg/FlameGraph.git $root; fi"]}, {"manager": "apt", "name": "flamegraph"}, {"manager": "dnf", "name": "flamegraph"}, {"manager": "pacman", "name": "flamegraph"}]}
    },
    {
      "name": "Xcode Command Line Tools",
      "category": "macOS",
      "description": "Clang, Make, LLDB et SDK macOS",
      "packages": {"darwin": [{"manager": "xcode-select", "name": "--install"}]}
