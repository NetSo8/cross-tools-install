{
  "version": 1,
  "tools": [
    {
      "name": "Ghidra",
      "category": "Reverse engineering",
      "description": "Décompilateur et framework d'analyse binaire",
      "packages": {
        "windows": [{"manager": "winget", "name": "NSA.Ghidra"}, {"manager": "scoop", "name": "ghidra"}],
        "linux": [{"manager": "script", "name": "ghidra", "command": "bash", "args": ["-c", "set -e; if ! command -v java >/dev/null 2>&1; then if command -v apt-get >/dev/null 2>&1; then sudo DEBIAN_FRONTEND=noninteractive apt-get update; sudo DEBIAN_FRONTEND=noninteractive apt-get install -y openjdk-21-jre; elif command -v dnf >/dev/null 2>&1; then sudo dnf install -y java-21-openjdk; elif command -v pacman >/dev/null 2>&1; then sudo pacman -S --noconfirm jre21-openjdk; else echo 'Java 21 et gestionnaire compatible introuvables' >&2; exit 1; fi; fi; root=$HOME/.local/opt; mkdir -p $root; asset=$(curl -fsSL -A cross-tools-install https://github.com/NationalSecurityAgency/ghidra/releases/latest | grep -oE '/NationalSecurityAgency/ghidra/releases/download/[^\" ]+PUBLIC[^\" ]+\\.zip' | head -n 1); test -n $asset; curl -fL https://github.com$asset -o $root/ghidra.zip; unzip -q -o $root/ghidra.zip -d $root; rm -f $root/ghidra.zip"]}, {"manager": "apt", "name": "ghidra"}, {"manager": "dnf", "name": "ghidra"}, {"manager": "pacman", "name": "ghidra"}],
        "darwin": [
          {"manager": "script", "name": "ghidra", "command": "bash", "args": ["-c", "set -e; brew install --cask temurin; root=$HOME/.local/opt; mkdir -p $root; asset=$(curl -fsSL -A cross-tools-install https://github.com/NationalSecurityAgency/ghidra/releases/latest | grep -oE '/NationalSecurityAgency/ghidra/releases/download/[^\" ]+PUBLIC[^\" ]+\\.zip' | head -n 1); test -n $asset; curl -fL https://github.com$asset -o $root/ghidra.zip; unzip -q -o $root/ghidra.zip -d $root; rm -f $root/ghidra.zip"]},
          {"manager": "brew", "name": "ghidra", "options": ["--cask"]}
        ]
      }
    },
    {
      "name": "Cutter / Rizin",
      "category": "Reverse engineering",
      "description": "Interface graphique moderne pour l'analyse de binaires",
      "packages": {
        "windows": [{"manager": "winget", "name": "rizinorg.Cutter"}, {"manager": "scoop", "name": "cutter"}],
        "linux": [{"manager": "script", "name": "cutter", "command": "bash", "args": ["-c", "set -e; root=$HOME/.local/bin; mkdir -p $root; asset=$(curl -fsSL -A cross-tools-install https://github.com/rizinorg/Cutter/releases/latest | grep -oE '/rizinorg/cutter/releases/download/[^\" ]+Cutter[^\" ]+Linux[^\" ]+AppImage' | grep -v Qt5 | head -n 1); test -n $asset; curl -fL https://github.com$asset -o $root/cutter; chmod +x $root/cutter"]}, {"manager": "apt", "name": "cutter"}, {"manager": "dnf", "name": "cutter"}, {"manager": "pacman", "name": "cutter"}],
        "darwin": [{"manager": "brew", "name": "rizin"}]
      }
    },
    {
      "name": "ImHex",
      "category": "Reverse engineering",
      "description": "Éditeur hexadécimal avec patterns PE, ELF et Mach-O",
      "packages": {
        "windows": [{"manager": "winget", "name": "WerWolv.ImHex"}, {"manager": "scoop", "name": "imhex"}],
        "linux": [{"manager": "script", "name": "imhex", "command": "bash", "args": ["-c", "set -e; root=$HOME/.local/bin; mkdir -p $root; machine=$(uname -m); if [ $machine = aarch64 ]; then pattern='arm64.AppImage'; else pattern='x86_64.AppImage'; fi; asset=$(curl -fsSL -A cross-tools-install https://github.com/WerWolv/ImHex/releases/latest | grep -oE '/WerWolv/ImHex/releases/download/[^\" ]+imhex-[^\" ]+'$pattern | head -n 1); test -n $asset; curl -fL https://github.com$asset -o $root/imhex; chmod +x $root/imhex"]}, {"manager": "apt", "name": "imhex"}, {"manager": "pacman", "name": "imhex"}],
        "darwin": [{"manager": "brew", "name": "imhex", "options": ["--cask"]}]
      }
    },
    {
      "name": "Wireshark",
      "category": "Reverse engineering",
      "description": "Analyseur de trafic réseau",
      "packages": {
        "windows": [{"manager": "scoop", "name": "wireshark"}, {"manager": "winget", "name": "WiresharkFoundation.Wireshark"}],
        "linux": [{"manager": "apt", "name": "wireshark"}, {"manager": "dnf", "name": "wireshark"}, {"manager": "pacman", "name": "wireshark-qt"}],
        "darwin": [{"manager": "brew", "name": "wireshark", "options": ["--cask"]}]
      }
    },
    {
      "name": "Frida",
      "category": "Reverse engineering",
      "description": "Instrumentation dynamique de processus",
