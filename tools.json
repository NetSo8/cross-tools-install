      "packages": {"windows": [{"manager": "winget", "name": "hasherezade.PE-bear"}, {"manager": "scoop", "name": "pe-bear"}]}
    },
    {
      "name": "w64devkit",
      "category": "Windows",
      "description": "Toolchain GCC portable pour Windows",
      "packages": {"windows": [{"manager": "scoop", "name": "w64devkit"}]}
    },
    {
      "name": "Visual Studio Build Tools",
      "category": "Windows",
      "description": "Compilateurs MSVC et SDK Windows natifs",
      "packages": {"windows": [{"manager": "winget", "name": "Microsoft.VisualStudio.2022.BuildTools"}]}
    },
    {
      "name": "GEF",
